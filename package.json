{
  "name": "luminar-iq-securescan",
  "private": true,
  "version": "0.1.0",
  "description": "LuminarIQ SecureScan defensive security audit SaaS platform.",
  "scripts": {
    "build": "corepack pnpm --filter @luminar-iq/shared --filter @luminar-iq/api --filter @luminar-iq/web --filter @luminar-iq/scanner-worker build",
    "lint": "corepack pnpm --filter @luminar-iq/shared --filter @luminar-iq/api --filter @luminar-iq/web --filter @luminar-iq/scanner-worker lint",
    "test": "corepack pnpm --filter @luminar-iq/shared --filter @luminar-iq/api --filter @luminar-iq/web --filter @luminar-iq/scanner-worker test",
    "dev:api": "corepack pnpm --filter @luminar-iq/api start:dev",
    "dev:web": "corepack pnpm --filter @luminar-iq/web dev",
    "dev:worker": "corepack pnpm --filter @luminar-iq/scanner-worker dev"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "body-parser": "1.20.6",
      "file-type": "21.3.2",
      "lodash": "4.18.0",
      "multer": "2.4.0",
      "postcss": "8.5.29",
      "proxy-addr": "2.0.8",
      "qs": "6.16.0",
      "sharp": "0.35.5"
    }
  }
}
