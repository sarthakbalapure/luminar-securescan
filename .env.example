NODE_ENV=development
API_PORT=4010
API_HOST=0.0.0.0
WEB_PORT=3700
WEB_ORIGIN=http://localhost:3700,http://127.0.0.1:3700,http://localhost:3010,http://127.0.0.1:3010
TRUST_PROXY=false
HSTS_MAX_AGE_SECONDS=15552000
DATABASE_URL=postgresql://securescan:securescan@127.0.0.1:55432/securescan
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
SENSITIVE_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-random-secret
REPOSITORY_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
SCANNER_ALLOWED_PRIVATE_NETWORKS=false
SCANNER_HTTP_TIMEOUT_MS=8000
SCANNER_MAX_RESPONSE_BYTES=32768
SCANNER_CHECK_TIMEOUT_MS=8000
SCAN_WORKER_CONCURRENCY=2
SCAN_WORKER_RATE_LIMIT_MAX=10
SCAN_WORKER_RATE_LIMIT_DURATION_MS=60000
SCAN_RATE_LIMIT_WINDOW_MINUTES=60
SCAN_RATE_LIMIT_MAX_PER_ORG=20
SCAN_CONCURRENCY_MAX_PER_ORG=3
REPORTS_ENABLED=true
REPORT_STORAGE_PATH=./storage/reports
REPORT_BRAND_NAME=LuminarIQ SecureScan
REPORT_COMPANY_NAME=LuminarIQ SoftSol Pvt. Ltd.
REPORT_LOGO_PATH=
REPORT_DEFAULT_FORMAT=pdf
REPORT_MAX_FINDINGS=500
REPORT_INCLUDE_RAW_EVIDENCE=false
ZAP_ENABLED=true
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=change-this-zap-key
ZAP_DEFAULT_SCAN_MODE=baseline
ZAP_BASELINE_TIMEOUT_SECONDS=300
ZAP_FULL_SCAN_TIMEOUT_SECONDS=1800
ZAP_API_REQUEST_TIMEOUT_MS=60000
ZAP_MAX_CONCURRENT_SCANS=1
ZAP_POLL_INTERVAL_MS=5000
ZAP_ALERT_LIMIT=100
NUCLEI_ENABLED=true
NUCLEI_MODE=binary
NUCLEI_BINARY_PATH=nuclei
NUCLEI_TEMPLATES_PATH=./nuclei-templates
NUCLEI_UPDATE_TEMPLATES=false
NUCLEI_DEFAULT_SCAN_MODE=safe_baseline
NUCLEI_TIMEOUT_SECONDS=600
NUCLEI_FULL_SCAN_TIMEOUT_SECONDS=1800
NUCLEI_RATE_LIMIT=5
NUCLEI_CONCURRENCY=5
NUCLEI_MAX_CONCURRENT_SCANS=1
NUCLEI_OUTPUT_DIR=./tmp/nuclei-results
SQLMAP_ENABLED=true
SQLMAP_BINARY_PATH=sqlmap
SQLMAP_TIMEOUT_SECONDS=600
SQLMAP_MAX_CONCURRENT_SCANS=1
SQLMAP_RISK=1
SQLMAP_LEVEL=1
SQLMAP_OUTPUT_DIR=./tmp/sqlmap-results
OPENAPI_FETCH_TIMEOUT_MS=8000
OPENAPI_MAX_SPEC_BYTES=500000
API_SCAN_TIMEOUT_MS=8000
API_SCAN_REQUEST_DELAY_MS=300
REPO_ZIP_MAX_BYTES=10485760
REPO_SCAN_MAX_FILE_BYTES=1048576
REPO_SCAN_MAX_FILES=5000
REPO_TOOL_TIMEOUT_MS=60000
REPO_SCAN_TIMEOUT_MS=300000
DATA_RETENTION_DAYS=365
ERROR_TRACKING_DSN=
METRICS_ENABLED=false
SECURITY_CONTACT_EMAIL=security@luminar.example
